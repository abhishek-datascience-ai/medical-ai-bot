# Application
APP_NAME="Medical-AI Bot"
APP_ENV="development"
APP_DEBUG=true
APP_HOST="127.0.0.1"
APP_PORT=8000

# Security
SECRET_KEY="replace-with-secure-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM Provider
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"

# Qdrant
QDRANT_MODE="local"
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_LOCAL_PATH="data/vector_store/qdrant"
QDRANT_COLLECTION_NAME="medical_ai_bot_chunks"

# Vector Settings
DENSE_VECTOR_NAME="dense"
SPARSE_VECTOR_NAME="bm25_sparse"
DENSE_VECTOR_SIZE=384

# Data Paths
RAW_DATA_DIR="data/raw/mediassist_data"
PROCESSED_DATA_DIR="data/processed"
SQLITE_DB_PATH="data/raw/mediassist_data/db/mediassist.db"

# Retrieval Settings
DENSE_TOP_K=10
RERANK_TOP_K=3

# Embedding Models
DENSE_EMBEDDING_MODEL_NAME="BAAI/bge-small-en-v1.5"
SPARSE_EMBEDDING_MODEL_NAME="Qdrant/bm25"
EMBEDDING_BATCH_SIZE=32
VECTOR_UPLOAD_BATCH_SIZE=64

# Reranking
RERANKER_MODEL_NAME="Xenova/ms-marco-MiniLM-L-6-v2"
CONTEXT_MAX_CHARS=6000

# LLM
LLM_PROVIDER="gemini"
LLM_MODE="cloud"

# Gemini
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048
